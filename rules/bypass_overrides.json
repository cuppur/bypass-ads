{
  "apps": [
    {
      "id": "app.bypassads.testad",
      "name": "Bypass Ads Test",
      "groups": [
        {
          "name": "开屏广告-通用测试",
          "ignoreGlobalGroupMatch": true,
          "rules": [
            {
              "key": 100,
              "name": "Bypass-Test-Close-Aggressive",
              "bypassMode": "AGGRESSIVE",
              "matches": [
                "[text=\"关闭\" || text=\"关闭广告\" || desc=\"关闭\" || desc=\"关闭广告\"][visibleToUser=true][clickable=true][width<300 && height<200]"
              ],
              "action": "clickCenter",
              "bypassOrigin": "OVERRIDE"
            },
            {
              "key": 101,
              "name": "Bypass-Test-ViewId-Aggressive",
              "bypassMode": "AGGRESSIVE",
              "matches": [
                "[vid~=\"(?is).*ad_close.*\"][visibleToUser=true]"
              ],
              "action": "clickCenter",
              "bypassOrigin": "OVERRIDE"
            },
            {
              "key": 102,
              "name": "Bypass-Test-X-Aggressive",
              "bypassMode": "AGGRESSIVE",
              "matches": [
                "[text=\"×\" || text=\"X\"][visibleToUser=true][clickable=true][width<120 && height<120]"
              ],
              "action": "clickCenter",
              "bypassOrigin": "OVERRIDE"
            },
            {
              "key": 103,
              "name": "Bypass-Test-Structural-Crazy",
              "bypassMode": "CRAZY",
              "matches": [
                "[clickable=true][visibleToUser=true][width<160 && height<160][name=\"android.view.View\" || name=\"android.widget.ImageView\"]"
              ],
              "action": "clickCenter",
              "bypassOrigin": "OVERRIDE"
            },
            {
              "key": 104,
              "name": "Bypass-Test-Coordinate-Crazy",
              "bypassMode": "CRAZY",
              "matches": [
                "[clickable=false][childCount=0][visibleToUser=true][width<200 && height<100][name=\"android.view.View\" || name=\"android.widget.ImageView\"]"
              ],
              "action": "clickCenter",
              "bypassOrigin": "OVERRIDE"
            },
            {
              "key": 105,
              "name": "Bypass-Test-Dedicated-Close",
              "matches": [
                "[text=\"关闭\"][visibleToUser=true][clickable=true][width<300 && height<200]"
              ],
              "action": "clickCenter",
              "bypassOrigin": "OVERRIDE"
            },
            {
              "key": 106,
              "name": "Bypass-Test-SkipViewId-Aggressive",
              "bypassMode": "AGGRESSIVE",
              "matches": [
                "[vid~=\"(?is).*skip.*\"][visibleToUser=true]"
              ],
              "action": "clickCenter",
              "bypassOrigin": "OVERRIDE"
            },
            {
              "key": 107,
              "name": "Bypass-Test-Repeated-Window-Delay",
              "bypassMode": "AGGRESSIVE",
              "order": -50,
              "actionDelay": 2200,
              "matches": [
                "[vid=\"waiting_exit_control\"][desc=\"关闭弹屏\"][visibleToUser=true]"
              ],
              "action": "clickCenter",
              "bypassOrigin": "OVERRIDE"
            }
          ]
        }
      ]
    },
    {
      "id": "app.bypassads.testad.exact",
      "name": "Bypass Ads Exact Test",
      "groups": [
        {
          "name": "开屏广告-确定性测试",
          "order": -20,
          "rules": [
            {
              "key": 0,
              "matches": [
                "[text=\"跳过广告\"][clickable=true][visibleToUser=true]"
              ],
              "action": "clickCenter",
              "bypassOrigin": "OVERRIDE"
            }
          ]
        }
      ]
    },
    {
      "id": "com.eg.android.AlipayGphone",
      "name": "支付宝",
      "groups": [
        {
          "name": "开屏广告-小程序开屏广告-补强",
          "activityIds": [
            "com.alipay.mobile.nebulax.remote.biz.XRiverActivity",
            "com.alipay.mobile.nebulaapp",
            "com.alipay.mobile.nebulax"
          ],
          "rules": [
            {
              "key": 210,
              "name": "Bypass-Alipay-Close-Aggressive",
              "bypassMode": "AGGRESSIVE",
              "actionDelay": 150,
              "anyMatches": [
                "[desc=\"关闭\" || desc=\"关闭弹屏\" || desc=\"關閉\" || desc=\"close\"][visibleToUser=true]",
                "[text=\"关闭\" || text=\"关闭弹屏\"][visibleToUser=true]",
                "[vid~=\"(?is).*(ad_close|close_ad|splash_close|close_btn|close_icon)\"][visibleToUser=true]"
              ],
              "bypassOrigin": "OVERRIDE",
              "action": "clickCenter",
              "matchRoot": true
            },
            {
              "key": 211,
              "name": "Bypass-Alipay-Skip",
              "anyMatches": [
                "[(text.length<16 && (text*=\"跳过\" || text*=\"跳 过\" || text*=\"跳過\" || text~=\"(?is).*\\bskip\\b.*\")) || (desc.length<16 && (desc*=\"跳过\" || desc*=\"跳 过\" || desc*=\"跳過\" || desc~=\"(?is).*\\bskip\\b.*\")) || (vid~=\"(?is).*(skip|mJumpBtn).*\" && vid!~=\"(?is).*(video|head|tail).*\")][visibleToUser=true][width<420 && height<260]",
                "@[clickable=true][visibleToUser=true][width<420 && height<260] > [childCount=0][visibleToUser=true][(text.length<16 && (text*=\"跳过\" || text*=\"跳 过\" || text*=\"跳過\" || text~=\"(?is).*\\bskip\\b.*\")) || (desc.length<16 && (desc*=\"跳过\" || desc*=\"跳 过\" || desc*=\"跳過\" || desc~=\"(?is).*\\bskip\\b.*\")) || (vid~=\"(?is).*(skip|mJumpBtn).*\" && vid!~=\"(?is).*(video|head|tail).*\")]"
              ],
              "actionDelay": 0,
              "bypassOrigin": "OVERRIDE",
              "matchRoot": true
            }
          ],
          "forcedTime": 10000,
          "matchRoot": true
        }
      ]
    },
    {
      "id": "com.tencent.mm",
      "name": "微信",
      "groups": [
        {
          "name": "开屏广告-微信小程序",
          "activityIds": [
            ".plugin.appbrand.ui.AppBrandUI",
            ".plugin.appbrand.launching.AppBrandLaunchProxyUI",
            ".plugin.appbrand.ui.AppBrandPluginUI"
          ],
          "rules": [
            {
              "key": 200,
              "name": "Bypass-WeChat-Skip",
              "actionDelay": 800,
              "anyMatches": [
                "[desc.length<16][desc*=\"跳过\" || desc*=\"跳 过\" || desc*=\"跳過\" || desc~=\"(?is).*\\bskip\\b.*\"][visibleToUser=true][width<420 && height<260]",
                "[text.length<16][text*=\"跳过\" || text*=\"跳 过\" || text*=\"跳過\" || text~=\"(?is).*\\bskip\\b.*\"][visibleToUser=true][width<420 && height<260]",
                "[vid~=\"(?is).*skip.*\"][vid!~=\"(?is).*(video|head|tail).*\"][visibleToUser=true][width<420 && height<260]",
                "@[clickable=true][visibleToUser=true][width<420 && height<260] > [childCount=0][visibleToUser=true][(text.length<16 && (text*=\"跳过\" || text*=\"跳 过\" || text*=\"跳過\" || text~=\"(?is).*\\bskip\\b.*\")) || (desc.length<16 && (desc*=\"跳过\" || desc*=\"跳 过\" || desc*=\"跳過\" || desc~=\"(?is).*\\bskip\\b.*\")) || (vid~=\"(?is).*(skip|mJumpBtn).*\" && vid!~=\"(?is).*(video|head|tail).*\")]"
              ],
              "bypassOrigin": "OVERRIDE",
              "action": "clickCenter",
              "order": -20,
              "matchRoot": true
            },
            {
              "key": 201,
              "name": "Bypass-WeChat-Close-Aggressive",
              "bypassMode": "AGGRESSIVE",
              "actionDelay": 800,
              "anyMatches": [
                "[desc=\"关闭\" || desc=\"关闭广告\" || desc=\"關閉\" || desc=\"close\" || desc=\"Close\"][visibleToUser=true]",
                "[text=\"关闭\" || text=\"关闭广告\" || text=\"關閉\" || text=\"Close\"][visibleToUser=true]",
                "[vid~=\"(?is).*(ad_close|close_ad|splash_close|close_btn|close_icon)\"][visibleToUser=true]"
              ],
              "bypassOrigin": "OVERRIDE",
              "action": "clickCenter",
              "order": -20,
              "matchRoot": true
            },
            {
              "key": 202,
              "name": "Bypass-WeChat-X-Aggressive",
              "bypassMode": "AGGRESSIVE",
              "actionDelay": 150,
              "matches": [
                "[text=\"X\" || text=\"×\" || text=\"✕\"][visibleToUser=true][width<120 && height<120]"
              ],
              "bypassOrigin": "OVERRIDE",
              "matchRoot": true
            },
            {
              "key": 203,
              "name": "Bypass-WeChat-Structural-Crazy",
              "bypassMode": "CRAZY",
              "actionDelay": 150,
              "anyMatches": [
                "[clickable=true][visibleToUser=true][width<160 && height<160][name=\"android.view.View\" || name=\"android.widget.ImageView\"]",
                "[clickable=false][childCount=0][visibleToUser=true][width<160 && height<160][name=\"android.view.View\" || name=\"android.widget.ImageView\"]"
              ],
              "bypassOrigin": "OVERRIDE",
              "matchRoot": true
            }
          ],
          "forcedTime": 10000,
          "matchRoot": true
        }
      ]
    },
    {
      "id": "com.tencent.qqmusic",
      "name": "QQ音乐",
      "groups": [
        {
          "name": "开屏广告-QQ音乐补强",
          "order": -15,
          "forcedTime": 10000,
          "actionCd": 750,
          "actionMaximum": 3,
          "rules": [
            {
              "key": 300,
              "name": "Bypass-QQMusic-Semantic",
              "anyMatches": [
                "[clickable=true][visibleToUser=true][width<420 && height<260][(text.length<16 && (text*=\"跳过\" || text*=\"跳 过\" || text*=\"跳過\" || text~=\"(?is).*\\bskip\\b.*\")) || (desc.length<16 && (desc*=\"跳过\" || desc*=\"跳 过\" || desc*=\"跳過\" || desc~=\"(?is).*\\bskip\\b.*\")) || (vid~=\"(?is).*(skip|mJumpBtn).*\" && vid!~=\"(?is).*(video|head|tail).*\")]",
                "@[clickable=true][visibleToUser=true][width<420 && height<260] > [childCount=0][visibleToUser=true][(text.length<16 && (text*=\"跳过\" || text*=\"跳 过\" || text*=\"跳過\" || text~=\"(?is).*\\bskip\\b.*\")) || (desc.length<16 && (desc*=\"跳过\" || desc*=\"跳 过\" || desc*=\"跳過\" || desc~=\"(?is).*\\bskip\\b.*\")) || (vid~=\"(?is).*(skip|mJumpBtn).*\" && vid!~=\"(?is).*(video|head|tail).*\")]"
              ],
              "bypassOrigin": "OVERRIDE"
            },
            {
              "key": 301,
              "name": "Bypass-QQMusic-Gesture",
              "matches": [
                "[clickable=false][childCount=0][visibleToUser=true][width<420 && height<260][(text.length<16 && (text*=\"跳过\" || text*=\"跳 过\" || text*=\"跳過\" || text~=\"(?is).*\\bskip\\b.*\")) || (desc.length<16 && (desc*=\"跳过\" || desc*=\"跳 过\" || desc*=\"跳過\" || desc~=\"(?is).*\\bskip\\b.*\")) || (vid~=\"(?is).*(skip|mJumpBtn).*\" && vid!~=\"(?is).*(video|head|tail).*\")]"
              ],
              "action": "clickCenter",
              "bypassOrigin": "OVERRIDE"
            },
            {
              "key": 302,
              "name": "Bypass-QQMusic-AdClose",
              "matches": [
                "[vid~=\"(?is).*(ad_?close|splash_?close|close_?ad).*\"][visibleToUser=true][width<420 && height<260]"
              ],
              "bypassMode": "AGGRESSIVE",
              "bypassOrigin": "OVERRIDE"
            }
          ]
        }
      ]
    }
  ]
}
